{
	"layer": "top",
	"position": "top",
	"height": 30,
	"margin" : 10,
	//"spacing" : 20,
	"modules-left" : ["custom/spacing-left","hyprland/workspaces","custom/roundright"],
	"modules-center" : ["custom/roundleft","clock#1","custom/clockSep","clock#2","custom/roundright"],
	"modules-right" : ["custom/roundleft","pulseaudio#output","pulseaudio#input","memory","cpu","tray","custom/rofi-powermenus","custom/spacing-right"],



	"custom/spacing-left" : {
		"format"  : " ",
	},
	"custom/spacing-right" : {
		"format"  : " ",
	},
	"hyprland/workspaces" : {
		"format" : "{name}:{icon}",
		"on-click" : "activate",
		"format-icons" : {
			"active" : "",
			"default" : "",
		},
		"sort-by-number" : true,
		"persistent-workspaces" : {
			"1" : [],
			"2" : [],
			"3" : [],
			"4" : [],

		},
	},
	"clock#1" : {
		"format" : "{:%H:%M}",
		"on-click" : "gnome-clocks",
	},
	"clock#2" : {
		"format" : "{:%d-%m}",
		"on-click" : "gnome-calendar",
	},
	"custom/clockSep" :{
		"format" : "|",
	},
	"tray" : {
		"icon-size" : 20,
	},
	"pulseaudio#output":{
		"on-click" : "pavucontrol",
		"format": "{icon}  {volume:2}%",
		"format-muted" : "",
		"format-icons": {
			"headphones": "",
			"default": [
				"",
				"",
				""
			]
		},
		"scroll-step" : 5,
	},
	"pulseaudio#input":{
		"disable-scroll" : true,
		"format-source" : "",
		"format-source-muted" : " ",
		"format" : "{format_source}",
		"on-click" : "pactl set-source-mute 62 toggle",
	},
	"custom/rofi-powermenus" :{
		"format" : " ",
		"on-click" : "/home/dhruv/.config/rofi/powermenu/type-2/powermenu.sh",
	},
	"memory": {
		"interval": 5,
		"format": "\uefc5 {}%"
	},
	"cpu": {
		"interval": 5,
		"format": "\uf4bc {usage:2}%"
	},
	"custom/roundright" : {
		"format" : "",
	},
	"custom/roundleft" : {
		"format" : "",
	},
}
